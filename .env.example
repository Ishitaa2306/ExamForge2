# ==============================================================================
# ExamForge Environment Configuration Template
# Copy this file to .env and configure with your real credentials.
# On Streamlit Community Cloud, enter these as App Secrets in the dashboard.
# ==============================================================================

# ── AI Provider Mode ─────────────────────────────────────────────────────────
# Strict Live Inference: Requires real Gemini and Granite credentials
AI_PROVIDER_MODE=live

# ── Google Gemini Configuration (Agents 1-4) ───────────────────────────────────
# Agent 1: Document Understanding, Agent 2: Question Generation,
# Agent 3: Autonomous Examiner, Agent 4: Final Report Synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-1.5-flash

# ── IBM watsonx.ai Granite Configuration (Agents 5-6) ─────────────────────────
# Agent 5: Answer Evaluation (5 weighted criteria), Agent 6: Knowledge Assessment
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_ibm_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Relational Database Configuration ─────────────────────────────────────────
# PostgreSQL (Production / Primary)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/examforge
# Note: For hosted PostgreSQL on Streamlit Cloud (e.g. Neon, Supabase, RDS), paste the connection URI:
# DATABASE_URL=postgresql://user:pass@ep-xyz.aws.neon.tech/examforge?sslmode=require
# For local standalone testing without PostgreSQL running:
# DATABASE_URL=sqlite:///storage/examforge.db

# ── Security & Authentication ─────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-secret-key-before-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Storage & Paths ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma
MODELS_DIR=storage/models
